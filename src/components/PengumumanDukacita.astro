---
// Banner pengumuman duka cita - konten sementara/urgent.
// Untuk menghapus pengumuman ini nanti: hapus <PengumumanDukacita /> dari
// src/pages/index.astro, lalu file ini boleh dihapus.
---

<section
  id="pengumuman-dukacita"
  class="relative bg-black"
  aria-label="Pengumuman duka cita"
>
  <button
    id="pengumuman-dukacita-close"
    type="button"
    aria-label="Tutup pengumuman"
    class="absolute top-3 right-3 z-10 w-9 h-9 flex items-center justify-center rounded-full bg-white/10 hover:bg-white/20 text-white transition-colors"
  >
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5">
      <line x1="18" y1="6" x2="6" y2="18" />
      <line x1="6" y1="6" x2="18" y2="18" />
    </svg>
  </button>

  <div class="max-w-md mx-auto py-6 px-4">
    <img
      src="/pengumuman/dukacita-welking.jpg"
      alt="Ucapan turut berduka cita dari Pemerintah Kampung Lotaq atas kepergian Gregorius Welking, S.Pd, Sekretaris Kecamatan Muara Lawa"
      class="w-full h-auto rounded-lg shadow-lg"
      width="900"
      height="1273"
    />
  </div>
</section>

<script>
  const STORAGE_KEY = 'lotaqDukacitaWelkingClosed';
  const banner = document.getElementById('pengumuman-dukacita');
  const closeBtn = document.getElementById('pengumuman-dukacita-close');

  if (sessionStorage.getItem(STORAGE_KEY)) {
    banner?.remove();
  }

  closeBtn?.addEventListener('click', () => {
    sessionStorage.setItem(STORAGE_KEY, '1');
    banner?.remove();
  });
</script>

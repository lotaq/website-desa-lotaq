---
// Banner pengumuman duka cita - konten sementara/urgent.
// Untuk menghapus pengumuman ini nanti: hapus <PengumumanDukacita /> dari
// src/pages/index.astro, lalu file ini boleh dihapus.
---

<section
  id="pengumuman-dukacita"
  class="relative bg-black lotaq-fade-in"
  aria-label="Pengumuman duka cita"
>
  <button
    id="pengumuman-dukacita-close"
    type="button"
    aria-label="Tutup pengumuman"
    class="absolute top-3 right-3 z-10 w-9 h-9 flex items-center justify-center rounded-full bg-white/10 hover:bg-white/20 text-white transition-colors"
  >
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5">
      <line x1="18" y1="6" x2="6" y2="18" />
      <line x1="6" y1="6" x2="18" y2="18" />
    </svg>
  </button>

  <div class="max-w-md mx-auto py-6 px-4">
    <img
      src="/pengumuman/dukacita-welking.jpg"
      alt="Ucapan turut berduka cita dari Pemerintah Kampung Lotaq atas kepergian Gregorius Welking, S.Pd, Sekretaris Kecamatan Muara Lawa"
      class="w-full h-auto rounded-lg shadow-lg"
      width="900"
      height="1273"
    />
  </div>
</section>

<script>
  const STORAGE_KEY = 'lotaqDukacitaWelkingClosed';
  const banner = document.getElementById('pengumuman-dukacita');
  const closeBtn = document.getElementById('pengumuman-dukacita-close');

  // === DEBUG SEMENTARA - akan dihapus setelah masalah animasi selesai ===
  console.log('[DEBUG] Script banner dukacita berjalan. Waktu:', performance.now().toFixed(0) + 'ms');
  if (banner) {
    console.log('[DEBUG] Class elemen banner:', banner.className);
    console.log('[DEBUG] Opacity awal (computed):', getComputedStyle(banner).opacity);
    console.log('[DEBUG] Animation-name (computed):', getComputedStyle(banner).animationName);
    console.log('[DEBUG] Animation-duration (computed):', getComputedStyle(banner).animationDuration);
    banner.addEventListener('animationstart', (e) => {
      console.log('[DEBUG] ▶ animationstart:', e.animationName, '@', performance.now().toFixed(0) + 'ms');
    });
    banner.addEventListener('animationend', (e) => {
      console.log('[DEBUG] ■ animationend:', e.animationName, '@', performance.now().toFixed(0) + 'ms');
    });
  } else {
    console.log('[DEBUG] ELEMEN BANNER TIDAK DITEMUKAN!');
  }
  // === AKHIR DEBUG SEMENTARA ===

  if (sessionStorage.getItem(STORAGE_KEY)) {
    banner?.remove();
  }

  closeBtn?.addEventListener('click', () => {
    sessionStorage.setItem(STORAGE_KEY, '1');
    banner?.remove();
  });
</script>

<style is:global>
  /* Entrance "Fade" ala PowerPoint: murni opacity, tanpa pergerakan posisi */
  .lotaq-fade-in {
    animation: lotaqFadeIn 4s ease-out both;
  }

  @keyframes lotaqFadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  /* Aksesibilitas: matikan animasi untuk pengguna yang mengaktifkan
     "reduce motion" di perangkat/browser mereka */
  @media (prefers-reduced-motion: reduce) {
    .lotaq-fade-in {
      animation: none;
    }
  }
</style>

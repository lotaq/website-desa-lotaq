const totalPersonel = kelembagaan.reduce((n, l) => {
  if (l.subKelompok) return n + l.subKelompok.reduce((m, g) => m + g.anggota.length, 0);
  return n + (l.anggota?.length ?? 0);
}, 0);
---

<BaseLayout
  title="Kelembagaan Kampung"
  description={`Lembaga kemasyarakatan ${kampung.namaLengkap}: BPK, RT, Lembaga Adat, PKK, Posyandu, dan Karang Taruna.`}
>
  <!-- Hero -->
  <section class="bg-gradient-to-br from-tanah-100 via-krem-100 to-sunset-50 pattern-dayak relative overflow-hidden">
    <div class="absolute top-10 right-10 w-72 h-72 bg-sunset-300/20 rounded-full blur-3xl"></div>
    <div class="container-section py-20 md:py-24 relative">
      <div class="max-w-4xl">
        <div class="eyebrow mb-4">Kelembagaan</div>
        <h1 class="headline-display text-tanah-900 mb-6 text-balance">
          Lembaga <span class="highlight-brush">Kemasyarakatan</span>.
        </h1>
        <p class="text-xl text-tanah-700 leading-relaxed max-w-3xl text-pretty">
          Struktur kelembagaan {kampung.namaLengkap} yang menopang tata kelola, permusyawaratan,
          pelestarian adat, dan partisipasi warga — {totalPersonel} pengurus dalam {kelembagaan.length} lembaga.
        </p>
      </div>
    </div>
  </section>

  {kelembagaan.map((lembaga, idx) => (
    <section class:list={[idx % 2 === 0 ? 'bg-white' : 'bg-krem-100', 'py-16 md:py-20']}>
      <div class="container-section">
        <div class="max-w-3xl mb-10">
          <div class="eyebrow mb-3">{lembaga.kategori}</div>
          <h2 class="font-headline text-3xl md:text-4xl font-medium text-tanah-900 leading-tight mb-3 text-balance">
            {lembaga.nama}
          </h2>
          <p class="text-base text-tanah-600 leading-relaxed">{lembaga.deskripsi}</p>
        </div>

        {lembaga.subKelompok ? (
          <div class="space-y-10">
            {lembaga.subKelompok.map((grup) => (
              <div>
                <h3 class="font-display font-bold text-lg text-sunset-700 mb-4 pb-2 border-b border-krem-200">
                  {grup.judul}
                </h3>
                <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
                  {grup.anggota.map((orang) => (
                    <div class="relative aspect-[3/4] rounded-2xl overflow-hidden border-2 border-sunset-500 shadow-md bg-krem-100">
                      <div class="absolute inset-0 flex items-center justify-center bg-gradient-sunset">
                        <span class="font-headline text-4xl font-bold text-white">{inisial(orang.nama)}</span>
                      </div>
                      {orang.foto && (
                        <img
                          src={orang.foto}
                          alt={`Foto ${orang.nama}`}
                          loading="lazy"
                          class="absolute inset-0 w-full h-full object-cover"
                          onerror="this.style.display='none';"
                        />
                      )}
                      <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/85 via-black/45 to-transparent pt-12 pb-4 px-3 text-center">
                        <p class="text-sunset-200 text-[11px] font-display font-semibold uppercase tracking-wide leading-tight">{orang.jabatan}</p>
                        <p class="text-white font-display font-bold text-sm leading-tight mt-1">{orang.nama}</p>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            ))}
          </div>
        ) : (
          <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
            {lembaga.anggota.map((orang) => (
              <div class="relative aspect-[3/4] rounded-2xl overflow-hidden border-2 border-sunset-500 shadow-md bg-krem-100">
                <div class="absolute inset-0 flex items-center justify-center bg-gradient-sunset">
                  <span class="font-headline text-4xl font-bold text-white">{inisial(orang.nama)}</span>
                </div>
                {orang.foto && (
                  <img
                    src={orang.foto}
                    alt={`Foto ${orang.nama}`}
                    loading="lazy"
                    class="absolute inset-0 w-full h-full object-cover"
                    onerror="this.style.display='none';"
                  />
                )}
                <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/85 via-black/45 to-transparent pt-12 pb-4 px-3 text-center">
                  <p class="text-sunset-200 text-[11px] font-display font-semibold uppercase tracking-wide leading-tight">{orang.jabatan}</p>
                  <p class="text-white font-display font-bold text-sm leading-tight mt-1">{orang.nama}</p>
                </div>
              </div>
            ))}
          </div>
        )}
      </div>
    </section>
  ))}
</BaseLayout>

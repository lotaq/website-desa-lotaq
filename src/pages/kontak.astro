---
import BaseLayout from '../layouts/BaseLayout.astro';
import { kampung } from '../data/kampung';

const WA = '6285652147263';
const HP = '0856-5214-7263';
const telHP = 'tel:' + HP.replace(/[^0-9]/g, '');
const waHref = `https://wa.me/${WA}?text=${encodeURIComponent('Halo, saya ingin menghubungi Pemerintah Kampung Lotaq.')}`;
const mapEmbed = 'https://maps.google.com/maps?q=-0.5253422,115.7593714&z=16&hl=id&output=embed';
const mapLink = 'https://www.google.com/maps/search/?api=1&query=-0.5253422,115.7593714';

const jam = [
  { hari: 'Senin – Kamis', jam: '08.00 – 15.00 WITA' },
  { hari: 'Jumat', jam: '08.00 – 11.00 WITA' },
  { hari: 'Sabtu – Minggu', jam: 'Tutup' },
];

const darurat = [
  { nama: 'Hotline Polres Kutai Barat', nomor: ['0811-5498-110', '0813-5011-4544'] },
  { nama: 'Pemadam Kebakaran (Damkar) Kabupaten', nomor: ['0821-5468-8877'] },
  { nama: 'Posko Damkar Melak (Korlap Fendi)', nomor: ['0812-5846-868'] },
  { nama: 'BPBD Kutai Barat (Banjir / Tanah Longsor)', nomor: ['0821-5329-3284'] },
  { nama: 'RSUD Harapan Insan Sendawar (RSUD HIS)', nomor: ['0545-4044001'] },
  { nama: 'RS Santa Familia Barong Tongkok', nomor: ['0822-5353-7119'] },
  { nama: 'Mobil Derek Dishub Kutai Barat', nomor: ['0852-4630-7844'] },
];
const telOf = (n: string) => 'tel:' + n.replace(/[^0-9]/g, '');

const kartuKontak = [
  { judul: 'Alamat Kantor', isi: kampung.alamat, aksiLabel: 'Buka di Peta', aksiHref: mapLink },
  { judul: 'Telepon & WhatsApp', isi: HP, aksiLabel: 'Chat WhatsApp', aksiHref: waHref, telpHref: telHP },
  { judul: 'Email Resmi', isi: kampung.email, aksiLabel: 'Kirim Email', aksiHref: `mailto:${kampung.email}` },
];
---

<BaseLayout
  title="Kontak & Pengaduan"
  description={`Hubungi Pemerintah ${kampung.namaLengkap}: alamat kantor, telepon, WhatsApp, email, peta lokasi, form pengaduan, dan nomor darurat penting.`}
>
  <section class="bg-gradient-to-br from-krem-100 via-krem-100 to-sunset-50 pattern-dayak relative overflow-hidden">
    <div class="absolute top-10 right-10 w-72 h-72 bg-sunset-300/20 rounded-full blur-3xl"></div>
    <div class="container-section py-16 md:py-20 relative">
      <div class="max-w-4xl">
        <div class="eyebrow mb-4">Kontak &amp; Pengaduan</div>
        <h1 class="headline-display text-tanah-900 mb-6 text-balance">Hubungi <span class="highlight-brush">kami</span>.</h1>
        <p class="text-xl text-tanah-700 leading-relaxed max-w-3xl text-pretty">
          Pemerintah {kampung.namaLengkap} terbuka untuk pertanyaan, aspirasi, dan pengaduan warga.
          Pilih kanal yang paling nyaman bagi Anda.
        </p>
      </div>
    </div>
  </section>

  <section class="container-section py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {kartuKontak.map((k) => (
        <div class="bg-white rounded-3xl border border-krem-200 shadow-sm p-7 flex flex-col">
          <div class="text-xs uppercase tracking-wider font-display font-semibold text-sunset-600 mb-2">{k.judul}</div>
          <p class="text-tanah-800 font-display font-semibold leading-snug mb-5 flex-1">{k.isi}</p>
          <div class="flex flex-wrap gap-2">
            <a href={k.aksiHref} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 px-3 py-2 rounded-full bg-sawah-600 hover:bg-sawah-700 text-white text-xs font-display font-semibold transition-colors">{k.aksiLabel}</a>
            {k.telpHref && (
              <a href={k.telpHref} class="inline-flex items-center gap-1.5 px-3 py-2 rounded-full bg-white border border-krem-200 text-tanah-700 hover:bg-krem-100 text-xs font-display font-semibold transition-colors">Telepon</a>
            )}
          </div>
        </div>
      ))}

      <div class="bg-gradient-sunset rounded-3xl shadow-sm p-7 text-white">
        <div class="text-xs uppercase tracking-wider font-display font-semibold text-white/80 mb-3">Jam Pelayanan</div>
        <ul class="space-y-2">
          {jam.map((j) => (
            <li class="flex justify-between items-baseline gap-3 text-sm">
              <span class="text-white/90">{j.hari}</span>
              <span class="font-display font-bold whitespace-nowrap">{j.jam}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="container-section pb-16">
    <div class="flex flex-wrap items-baseline justify-between gap-3 mb-6">
      <h2 class="font-headline text-3xl md:text-4xl font-medium text-tanah-900 leading-tight text-balance">Lokasi Kantor.</h2>
      <a href={mapLink} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-white border border-krem-200 text-tanah-700 hover:bg-krem-100 text-sm font-display font-semibold transition-colors">Buka di Google Maps</a>
    </div>
    <div class="rounded-3xl overflow-hidden border border-krem-200 shadow-sm">
      <iframe src={mapEmbed} width="100%" height="440" style="border:0; display:block;" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title={`Peta ${kampung.namaLengkap}`}></iframe>
    </div>
    <p class="text-xs text-tanah-400 mt-3">Titik peta: Kantor Kampung Lotaq, Kecamatan Muara Lawa, Kutai Barat.</p>
  </section>

  <section class="bg-krem-100 py-16 md:py-24">
    <div class="container-section">
      <div class="grid grid-cols-1 lg:grid-cols-5 gap-10">
        <div class="lg:col-span-2">
          <div class="eyebrow mb-4">Kirim Pesan</div>
          <h2 class="font-headline text-4xl font-medium text-tanah-900 leading-tight mb-6 text-balance">Punya pertanyaan atau pengaduan?</h2>
          <p class="text-tanah-600 leading-relaxed mb-6">
            Sampaikan langsung kepada kami. Setiap pesan diteruskan ke email resmi kampung dan ditanggapi
            sesuai tata kelola pelayanan publik.
          </p>
          <ul class="space-y-3">
            {['Pesan diteruskan ke email resmi kampung', 'Identitas pengirim dijaga kerahasiaannya', 'Pengaduan ditindaklanjuti sesuai prosedur'].map((t) => (
              <li class="flex items-start gap-2.5 text-tanah-700">
                <svg class="w-5 h-5 mt-0.5 shrink-0 text-sawah-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                <span>{t}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="lg:col-span-3">
          <form action="https://api.web3forms.com/submit" method="POST" class="bg-white border border-krem-200 rounded-3xl p-8 shadow-sm space-y-5">
            <input type="hidden" name="access_key" value="11a7c03e-8f8b-4f1b-97e8-5f9ca98f33fb" />
            <input type="hidden" name="subject" value="Pesan/Pengaduan dari Website Kampung Lotaq" />
            <input type="hidden" name="from_name" value="Website Kampung Lotaq" />
            <input type="checkbox" name="botcheck" class="hidden" style="display:none;" tabindex="-1" autocomplete="off" />

            <div>
              <label class="block text-sm font-display font-semibold text-tanah-800 mb-1.5">Nama Lengkap <span class="text-sunset-600">*</span></label>
              <input type="text" name="nama" required placeholder="Nama Anda" class="w-full px-4 py-3 rounded-xl border border-krem-200 focus:border-sunset-500 focus:ring-1 focus:ring-sunset-500 outline-none transition-colors" />
            </div>
            <div>
              <label class="block text-sm font-display font-semibold text-tanah-800 mb-1.5">Alamat Email <span class="text-sunset-600">*</span></label>
              <input type="email" name="email" required placeholder="email@contoh.com" class="w-full px-4 py-3 rounded-xl border border-krem-200 focus:border-sunset-500 focus:ring-1 focus:ring-sunset-500 outline-none transition-colors" />
            </div>
            <div>
              <label class="block text-sm font-display font-semibold text-tanah-800 mb-1.5">Kategori <span class="text-sunset-600">*</span></label>
              <select name="kategori" required class="w-full px-4 py-3 rounded-xl border border-krem-200 focus:border-sunset-500 focus:ring-1 focus:ring-sunset-500 outline-none transition-colors bg-white">
                <option value="" disabled selected>Pilih kategori pesan</option>
                <option value="Pertanyaan Umum">Pertanyaan Umum</option>
                <option value="Pengaduan">Pengaduan</option>
                <option value="Saran / Aspirasi">Saran / Aspirasi</option>
                <option value="Layanan Administrasi">Layanan Administrasi</option>
                <option value="Lainnya">Lainnya</option>
              </select>
            </div>
            <div>
              <label class="block text-sm font-display font-semibold text-tanah-800 mb-1.5">Pesan <span class="text-sunset-600">*</span></label>
              <textarea name="pesan" required rows="5" placeholder="Tuliskan pesan atau pengaduan Anda di sini..." class="w-full px-4 py-3 rounded-xl border border-krem-200 focus:border-sunset-500 focus:ring-1 focus:ring-sunset-500 outline-none transition-colors resize-y"></textarea>
            </div>
            <button type="submit" class="w-full px-6 py-3.5 rounded-full bg-gradient-sunset text-white font-display font-bold shadow-md hover:shadow-lg transition-shadow">Kirim Pesan</button>
            <p class="text-xs text-tanah-400 text-center">Dengan mengirim pesan, Anda menyetujui pesan diteruskan ke email resmi kampung.</p>
          </form>
        </div>
      </div>
    </div>
  </section>

  <section class="container-section py-16 md:py-20">
    <div class="max-w-3xl mb-10">
      <div class="eyebrow mb-3">Darurat</div>
      <h2 class="font-headline text-3xl md:text-4xl font-medium text-tanah-900 leading-tight mb-4 text-balance">Nomor Penting.</h2>
      <p class="text-base text-tanah-600 leading-relaxed">Kontak layanan darurat wilayah Kutai Barat. Tekan nomor untuk memanggil langsung.</p>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {darurat.map((d) => (
        <div class="bg-white rounded-2xl border border-krem-200 shadow-sm p-5">
          <div class="font-display font-bold text-sm text-tanah-900 mb-2 leading-snug">{d.nama}</div>
          <div class="flex flex-wrap gap-2">
            {d.nomor.map((n) => (
              <a href={telOf(n)} class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-sunset-100 text-sunset-700 hover:bg-sunset-500 hover:text-white text-sm font-display font-semibold tabular-nums transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" /></svg>
                {n}
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>

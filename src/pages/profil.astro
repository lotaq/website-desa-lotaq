---
import BaseLayout from '../layouts/BaseLayout.astro';
import { kampung, petinggi, visiMisi } from '../data/kampung';

// Aparatur Pemerintah Kampung Lotaq (sesuai Bagan Struktur Organisasi resmi)
const aparatur = [
  { jabatan: 'Kepala Kampung', nama: 'KARYA MUSNI. Y', foto: petinggi.foto },
  { jabatan: 'Sekretaris Kampung', nama: 'YATI. M, S.Pd', foto: '/sotk-yati.jpg' },
  { jabatan: 'Kasi Pemerintahan', nama: 'SARNI', foto: '/sotk-sarni.jpg' },
  { jabatan: 'Kasi Kesejahteraan dan Pelayanan', nama: 'YULFIA HANDAYANI', foto: '/sotk-yulfia.jpg' },
  { jabatan: 'Kaur Umum dan Perencanaan', nama: 'DIAN NENSY OCTAVIA', foto: '/sotk-dian.jpg' },
  { jabatan: 'Kaur Keuangan', nama: 'IKA RAHAYU', foto: '/sotk-ika.jpg' },
];

function inisial(nama: string) {
  const bersih = nama.replace(/[.,]/g, ' ').replace(/\bS\s*Pd\b/gi, '').trim();
  const kata = bersih.split(/\s+/).filter(Boolean);
  if (kata.length === 0) return '-';
  if (kata.length === 1) return kata[0].slice(0, 2).toUpperCase();
  return (kata[0][0] + kata[1][0]).toUpperCase();
}

// Demografi Kampung Lotaq (data tahun 2026)
const demografi = {
  tahun: 2026,
  totalPenduduk: 450,
  lakiLaki: 235,
  perempuan: 215,
  kepalaKeluarga: 156,
  jumlahRT: 3,
  luasWilayahHa: 11500,
  sukuDominan: 'Dayak Benuaq',
  agama: [
    { nama: 'Kristen', jumlah: 198 },
    { nama: 'Katolik', jumlah: 185 },
    { nama: 'Islam', jumlah: 66 },
    { nama: 'Hindu', jumlah: 1 },
  ],
  mataPencaharian: ['Petani', 'Swasta', 'Peternak', 'Tukang', 'Pedagang', 'PNS'],
};

// Sejarah Kampung Lotaq (dituturkan sesepuh & tetua kampung)
const sejarah = [
  'Menurut penuturan para sesepuh dan tetua Kampung Lotaq, pada masa lampau wilayah ini merupakan lokasi ladang. Lakur — bergelar Jaya Mantitn Tementengk — adalah orang yang pertama kali membuka ladang di kawasan ini, kemudian diikuti oleh warga masyarakat Tementengk. Setelah beliau kembali ke Kampung Tementengk (Kampung Dingin), barulah Kampung Lotaq terbentuk.',
  'Merujuk pada sejarah Kabupaten Kutai Kartanegara, Daerah Istimewa Kutai pada tahun 1959 dibagi menjadi tiga Daerah Tingkat II, salah satunya Kabupaten Kutai dengan ibu kota Tenggarong. Pada masa itu, Lotaq menjadi bagian dari Kabupaten Kutai.',
  'Petinggi pertama Kampung Lotaq adalah Kakah Mamih (Ngeon), dan hingga kini tercatat 12 Petinggi (Kepala Kampung) yang telah memimpin. Sejak awal berdirinya, Kampung Lotaq senantiasa menjaga dan mewariskan tradisi leluhur serta adat istiadat suku Dayak Benuaq, yang tetap dipegang teguh dan dilaksanakan oleh seluruh warga.',
];
---

<BaseLayout 
  title="Profil Kampung"
  description={`Mengenal lebih dekat ${kampung.namaLengkap}. Sejarah, visi misi, dan struktur pemerintahan kampung yang kaya akan tradisi dan inovasi.`}
>
  <!-- Hero Profil -->
  <section class="bg-gradient-to-br from-tanah-100 via-krem-100 to-sunset-50 pattern-dayak relative overflow-hidden">
    <div class="absolute top-10 right-10 w-72 h-72 bg-sunset-300/20 rounded-full blur-3xl"></div>
    
    <div class="container-section py-20 md:py-24 relative">
      <div class="max-w-4xl">
        <div class="eyebrow mb-4">Profil Kampung</div>
        <h1 class="headline-display text-tanah-900 mb-6 text-balance">
          Mengenal <span class="highlight-brush">{kampung.nama}</span>.
        </h1>
        <p class="text-xl text-tanah-700 leading-relaxed max-w-3xl text-pretty">
          Sebuah kampung di jantung Kabupaten Kutai Barat, lahir dari keluhuran tradisi 
          dan tumbuh dengan semangat <em class="font-headline italic text-sunset-700">"{kampung.slogan}"</em>.
        </p>
      </div>
    </div>
  </section>

  <!-- Identitas Resmi -->
  <section class="container-section py-20">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
      <div class="lg:col-span-1">
        <div class="eyebrow mb-4">Identitas</div>
        <h2 class="font-headline text-3xl font-medium text-tanah-900 leading-tight">
          Data resmi pemerintahan.
        </h2>
      </div>

      <div class="lg:col-span-2">
        <dl class="grid grid-cols-1 sm:grid-cols-2 gap-6 bg-white rounded-3xl border border-krem-200 p-8 shadow-sm">
          <div>
            <dt class="text-xs uppercase tracking-wider font-display font-semibold text-sunset-600 mb-1">Nama Resmi</dt>
            <dd class="text-lg font-display font-bold text-tanah-900">{kampung.namaLengkap}</dd>
          </div>
          <div>
            <dt class="text-xs uppercase tracking-wider font-display font-semibold text-sunset-600 mb-1">Kecamatan</dt>
            <dd class="text-lg font-display font-bold text-tanah-900">{kampung.kecamatan}</dd>
          </div>
          <div>
            <dt class="text-xs uppercase tracking-wider font-display font-semibold text-sunset-600 mb-1">Kabupaten</dt>
            <dd class="text-lg font-display font-bold text-tanah-900">{kampung.kabupaten}</dd>
          </div>
          <div>
            <dt class="text-xs uppercase tracking-wider font-display font-semibold text-sunset-600 mb-1">Provinsi</dt>
            <dd class="text-lg font-display font-bold text-tanah-900">{kampung.provinsi}</dd>
          </div>
          <div>
            <dt class="text-xs uppercase tracking-wider font-display font-semibold text-sunset-600 mb-1">Kode Pos</dt>
            <dd class="text-lg font-display font-bold text-tanah-900 font-mono">{kampung.kodePos}</dd>
          </div>
          <div>
            <dt class="text-xs uppercase tracking-wider font-display font-semibold text-sunset-600 mb-1">Kode Wilayah</dt>
            <dd class="text-lg font-display font-bold text-tanah-900 font-mono">{kampung.kodeWilayah}</dd>
          </div>
          <div class="sm:col-span-2 pt-4 border-t border-krem-200">
            <dt class="text-xs uppercase tracking-wider font-display font-semibold text-sunset-600 mb-1">Email Resmi</dt>
            <dd class="text-lg font-display font-bold">
              <a href={`mailto:${kampung.email}`} class="text-sunset-600 hover:text-sunset-700 transition-colors">
                {kampung.email}
              </a>
            </dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <!-- Sejarah -->
  <section class="container-section py-20 md:py-28">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
      <div class="lg:col-span-1">
        <div class="eyebrow mb-4">Sejarah</div>
        <h2 class="font-headline text-4xl md:text-5xl font-medium text-tanah-900 leading-tight text-balance">
          Jejak asal-usul Kampung Lotaq.
        </h2>
      </div>
      <div class="lg:col-span-2 space-y-6">
        {sejarah.map((paragraf) => (
          <p class="text-lg text-tanah-600 leading-relaxed text-pretty">{paragraf}</p>
        ))}
      </div>
    </div>
  </section>

  <!-- Demografi -->
  <section class="bg-krem-100 py-20 md:py-28">
    <div class="container-section">
      <div class="max-w-3xl mb-14">
        <div class="eyebrow mb-4">Demografi</div>
        <h2 class="font-headline text-4xl md:text-5xl font-medium text-tanah-900 leading-tight mb-6 text-balance">
          Potret kependudukan.
        </h2>
        <p class="text-lg text-tanah-600 leading-relaxed">
          Data kependudukan {kampung.namaLengkap} tahun {demografi.tahun}.
        </p>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4 mb-12">
        {[
          { label: 'Total Penduduk', nilai: demografi.totalPenduduk.toLocaleString('id-ID'), satuan: 'jiwa' },
          { label: 'Laki-laki', nilai: demografi.lakiLaki.toLocaleString('id-ID'), satuan: 'jiwa' },
          { label: 'Perempuan', nilai: demografi.perempuan.toLocaleString('id-ID'), satuan: 'jiwa' },
          { label: 'Kepala Keluarga', nilai: demografi.kepalaKeluarga.toLocaleString('id-ID'), satuan: 'KK' },
          { label: 'Rukun Tetangga', nilai: demografi.jumlahRT, satuan: 'RT' },
          { label: 'Luas Wilayah', nilai: demografi.luasWilayahHa.toLocaleString('id-ID'), satuan: 'Ha' },
        ].map((s) => (
          <div class="bg-white rounded-2xl border border-krem-200 p-5 shadow-sm text-center">
            <div class="font-headline text-3xl font-bold text-sunset-600 tabular-nums">{s.nilai}</div>
            <div class="text-xs text-tanah-500 mt-1">{s.satuan}</div>
            <div class="text-sm font-display font-semibold text-tanah-800 mt-2">{s.label}</div>
          </div>
        ))}
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div class="bg-white rounded-3xl border border-krem-200 p-8 shadow-sm">
          <h3 class="font-display font-bold text-lg text-tanah-900 mb-6">Komposisi Pemeluk Agama</h3>
          <div class="space-y-4">
            {demografi.agama.map((a) => {
              const persen = Math.round((a.jumlah / demografi.totalPenduduk) * 1000) / 10;
              return (
                <div>
                  <div class="flex justify-between text-sm mb-1">
                    <span class="font-display font-semibold text-tanah-800">{a.nama}</span>
                    <span class="text-tanah-500 tabular-nums">{a.jumlah} jiwa · {persen}%</span>
                  </div>
                  <div class="h-2.5 rounded-full bg-krem-200 overflow-hidden">
                    <div class="h-full rounded-full bg-gradient-sunset" style={`width: ${persen}%`}></div>
                  </div>
                </div>
              );
            })}
          </div>
        </div>

        <div class="space-y-6">
          <div class="bg-white rounded-3xl border border-krem-200 p-8 shadow-sm">
            <h3 class="font-display font-bold text-lg text-tanah-900 mb-4">Mata Pencaharian Utama</h3>
            <ol class="space-y-2">
              {demografi.mataPencaharian.map((mp, i) => (
                <li class="flex items-center gap-3">
                  <span class="w-6 h-6 shrink-0 rounded-full bg-sunset-100 text-sunset-700 font-display font-bold text-xs flex items-center justify-center tabular-nums">{i + 1}</span>
                  <span class="text-tanah-700 font-display">{mp}</span>
                </li>
              ))}
            </ol>
          </div>
          <div class="bg-gradient-sunset rounded-3xl p-8 shadow-sm text-white">
            <div class="text-xs uppercase tracking-wider font-display font-semibold text-white/80 mb-1">Suku / Etnis Dominan</div>
            <div class="font-headline text-3xl font-bold">{demografi.sukuDominan}</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Visi -->
  <section class="bg-gradient-sunset py-20 md:py-24 relative overflow-hidden">
    <div class="absolute inset-0 pattern-dayak opacity-50"></div>
    <div class="container-section relative">
      <div class="max-w-4xl mx-auto text-center">
        <div class="inline-flex items-center gap-2 text-xs uppercase tracking-[0.3em] font-display font-semibold text-white/80 mb-6">
          <span class="w-8 h-px bg-white/60"></span>
          Visi
          <span class="w-8 h-px bg-white/60"></span>
        </div>
        <h2 class="font-headline italic text-5xl md:text-6xl lg:text-7xl text-white font-medium leading-tight mb-8">
          "{visiMisi.visi}"
        </h2>
        <p class="text-lg md:text-xl text-white/90 max-w-3xl mx-auto leading-relaxed text-pretty">
          {visiMisi.visiPanjang}
        </p>
      </div>
    </div>
  </section>

  <!-- Misi -->
  <section class="container-section py-20 md:py-28">
    <div class="max-w-3xl mb-16">
      <div class="eyebrow mb-4">Misi</div>
      <h2 class="font-headline text-4xl md:text-5xl font-medium text-tanah-900 leading-tight mb-6 text-balance">
        Lima jalan menuju visi.
      </h2>
      <p class="text-lg text-tanah-600 leading-relaxed">
        Langkah-langkah strategis untuk mewujudkan Kampung Lotaq yang Maju, Mandiri, dan Sejahtera.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {visiMisi.misi.map((misi) => (
        <div class="bg-white rounded-3xl border border-krem-200 p-8 hover:border-sunset-300 hover:shadow-lg transition-all">
          <div class="font-headline text-5xl font-bold text-sunset-500/30 mb-4 tabular-nums">
            {misi.nomor}
          </div>
          <h3 class="font-display font-bold text-xl text-tanah-900 mb-3">
            {misi.judul}
          </h3>
          <p class="text-tanah-600 leading-relaxed text-sm">
            {misi.deskripsi}
          </p>
        </div>
      ))}
    </div>
  </section>

  <!-- Struktur Organisasi & Aparatur -->
  <section class="bg-krem-100 py-20 md:py-28">
    <div class="container-section">
      <div class="max-w-3xl mb-14">
        <div class="eyebrow mb-4">Pemerintahan</div>
        <h2 class="font-headline text-4xl md:text-5xl font-medium text-tanah-900 leading-tight mb-6 text-balance">
          Struktur Organisasi &amp; Aparatur.
        </h2>
        <p class="text-lg text-tanah-600 leading-relaxed">
          Susunan Organisasi dan Tata Kerja (SOTK) {kampung.namaLengkap}, dipimpin oleh Petinggi Kampung
          bersama Sekretaris Kampung, Kepala Seksi, dan Kepala Urusan.
        </p>
      </div>

      <div class="mb-20">
        <h3 class="font-display font-bold text-xl text-tanah-900 mb-6 pb-3 border-b border-krem-200">
          Bagan Struktur Organisasi
        </h3>
        <div class="bg-white rounded-3xl border border-krem-200 shadow-sm p-4 sm:p-8">
          <img
            src="/sotk-bagan.jpg"
            alt={`Bagan Struktur Organisasi ${kampung.namaLengkap}`}
            loading="lazy"
            class="w-full h-auto max-w-3xl mx-auto rounded-xl"
          />
        </div>
      </div>

      <div data-carousel-wrap>
        <div class="flex items-center justify-between mb-6 pb-3 border-b border-krem-200">
          <h3 class="font-display font-bold text-xl text-tanah-900">Aparatur Kampung</h3>
          <div class="flex gap-2">
            <button data-prev type="button" aria-label="Sebelumnya"
              class="w-10 h-10 rounded-full bg-white border border-krem-200 shadow-sm flex items-center justify-center text-tanah-700 hover:bg-sunset-500 hover:text-white hover:border-sunset-500 transition-colors">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
            </button>
            <button data-next type="button" aria-label="Berikutnya"
              class="w-10 h-10 rounded-full bg-white border border-krem-200 shadow-sm flex items-center justify-center text-tanah-700 hover:bg-sunset-500 hover:text-white hover:border-sunset-500 transition-colors">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </button>
          </div>
        </div>

        <div data-carousel class="flex gap-5 overflow-x-auto snap-x snap-mandatory scroll-smooth pb-4 -mx-1 px-1">
          {aparatur.map((orang) => (
            <div class="snap-start shrink-0 w-56 sm:w-60">
              <div class="relative aspect-[3/4] rounded-2xl overflow-hidden border-2 border-sunset-500 shadow-md bg-krem-100">
                <img
                  src={orang.foto}
                  alt={`Foto ${orang.nama}`}
                  loading="lazy"
                  class="absolute inset-0 w-full h-full object-cover"
                  onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                />
                <div class="absolute inset-0 hidden items-center justify-center bg-gradient-sunset">
                  <span class="font-headline text-5xl font-bold text-white">{inisial(orang.nama)}</span>
                </div>
                <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/85 via-black/45 to-transparent pt-12 pb-4 px-3 text-center">
                  <p class="text-sunset-200 text-[11px] font-display font-semibold uppercase tracking-wide leading-tight">{orang.jabatan}</p>
                  <p class="text-white font-display font-bold text-sm leading-tight mt-1">{orang.nama}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <script>
    document.querySelectorAll('[data-carousel-wrap]').forEach((wrap) => {
      const track = wrap.querySelector('[data-carousel]') as HTMLElement | null;
      if (!track) return;
      const step = () => Math.max(track.clientWidth * 0.8, 240);
      wrap.querySelector('[data-prev]')?.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
      wrap.querySelector('[data-next]')?.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));
    });
  </script>
</BaseLayout>
